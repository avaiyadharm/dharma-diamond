# Shared app settings
SECRET_KEY=replace-this-with-a-long-random-secret
API_V1_STR=/api/v1

# Single-admin bootstrap
ADMIN_EMAIL=admin@dharmadiamond.local
ADMIN_PASSWORD=change-me-please
ADMIN_FULL_NAME=Dharma Diamond Admin

# Database
DATABASE_URL=sqlite:///./dharma_diamond.db
# For PostgreSQL use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dharma_diamond

# Business defaults
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
DEFAULT_GST_RATE=3.0
